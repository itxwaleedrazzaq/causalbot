<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="drone">


    <xacro:property name="namespace"  value="drone"/>

    <xacro:property name="arm_length"  value="0.55"/>
    <xacro:property name="arm_radius"  value="${arm_length/15.0}"/> 
    <xacro:property name="prop_radius" value="${arm_length/4.0}"/>

    <xacro:property name="base_radius" value="${arm_length/6.0}"/>
    <xacro:property name="base_height" value="${base_radius}"/>

    <xacro:property name="base_mass" value="0.1"/>
    <xacro:property name="arm_mass" value="${base_mass/10.0}"/>
    <xacro:property name="prop_mass" value="${base_mass/10.0}"/>

    <xacro:property name='correction' value='1.0'/>



    <material name="blue">  <color rgba="0.1 0.3 0.9 1.0"/> </material>   <!-- royal blue -->
    <material name="green"> <color rgba="0.6 1.0 0.1 1.0"/> </material>   <!-- lime / acid green -->
    <material name="white"> <color rgba="1.0 1.0 1.0 1.0"/> </material>   <!-- pure white -->
    <material name="black"> <color rgba="0.1 0.1 0.1 1.0"/> </material>   <!-- charcoal -->



    <xacro:include filename='intertial_macros.urdf.xacro'/>    <!-- intertial-marcos -->
    <xacro:include filename='body_macros.urdf.xacro'/>         <!-- body-marcos -->
    <xacro:include filename='uav.urdf.xacro'/>              <!-- drone-chassis -->
    <xacro:include filename='camera.urdf.xacro'/>              <!-- adding camera -->

    <xacro:include filename='gazebo_plugin.urdf.xacro' /> 


</robot>

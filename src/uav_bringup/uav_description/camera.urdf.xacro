<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="camera">

    <xacro:property name="camera_radius" value="${base_radius/2.0}"/>
    <xacro:property name="camera_height" value="${base_radius * 0.75}"/>
    <xacro:property name='camera_mass' value='${base_mass/10.0}'/>

    <link name="camera_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 ${-pi/2} 0.0"/>
            <geometry> <cylinder radius="${camera_radius}" length="${camera_height}"/> </geometry>
            <material name="black"/>
            <xacro:cylinder_inertia m='${camera_mass}' r='${correction * camera_radius}' h='${correction * camera_height}' />
            <collision>
                <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
                <geometry> <cylinder radius="${camera_radius}" length="${camera_height}"/> </geometry>
            </collision>
        </visual>  
    </link>

    <joint name="base_camera" type="fixed">
        <parent link="base_link"/>
        <child link="camera_link"/>
        <origin xyz="0.0 0.0 ${camera_height + base_height/4.0}" rpy="0 0.0 0.0"/>
    </joint>

    <!-- This is a fix for opencv -->
    <link name="camera_link_optical"></link>
    <joint name="camera_optical_joint" type="fixed">
        <origin xyz="0 0 0" rpy="0.0 0.0 0.0"/>
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
    </joint>

    <gazebo reference='camera_link'>
        <sensor name="camera_sensor" type="camera" update_rate="10.0">
            <parent link="camera_link"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <visualize>true</visualize>

            <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
                <width>320</width>
                <height>240</height>
                <format>R8G8B8</format>
            </image>
            <clip>
                <near>0.1</near>
                <far>100</far>
            </clip>
            </camera>

            <plugin name="camera_driver" filename="libgazebo_ros_camera.so">
                <frame_name>camera_link_optical</frame_name>
            </plugin>
        </sensor>
    </gazebo>


</robot>
